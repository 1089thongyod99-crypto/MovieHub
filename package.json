{
  "name": "moviehub",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22.16.0",
    "npm": "10.9.2"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preflight": "bash scripts/preflight-check.sh"
  },
  "dependencies": {
    "cors": "2.8.5",
    "express": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.44.1",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.0",
    "@types/node": "22.5.4",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tsx": "4.16.2",
    "typescript": "5.5.4",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  }
}
